APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://unibot:unibot@db:5432/unibot
REDIS_URL=redis://redis:6379/0

# Получите токен в кабинете разработчика MAX. Никогда не коммитьте настоящий токен.
MAX_TOKEN=replace_with_max_bot_token
# Публичный HTTPS URL, на который MAX будет отправлять обновления.
MAX_WEBHOOK_URL=https://bot.example.org/api/max/webhook
# Секрет, передаваемый MAX в заголовке X-Webhook-Secret (задайте при регистрации webhook).
MAX_WEBHOOK_SECRET=change-me-to-a-long-random-string
MAX_API_BASE_URL=https://platform-api.max.ru
ADMIN_MAX_USER_IDS=
